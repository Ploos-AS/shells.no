# Shells.no M1 node identity
SHELLS_NODE_NAME=shell01
SHELLS_NODE_FQDN=shell01.shells.no

# Provider metadata is informational and must not change core behaviour.
SHELLS_PROVIDER=example
SHELLS_PROVIDER_REGION=example

# Public addressing is populated after provider allocation.
SHELLS_PUBLIC_IPV4=
SHELLS_IPV6_PREFIX=

# Keep provider adapters separate from core provisioning.
SHELLS_PROVIDER_ADAPTER=manual
