#!/bin/sh
set -eu
die(){ echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -eq 1 ] || die "usage: shells-backup LOGIN"
login="$1"; id "$login" >/dev/null 2>&1 || die "unknown account"
uid="$(id -u "$login")"; aid="u-$uid"; root="/srv/shells/users/$aid"
[ -d "$root" ] || die "account storage missing: $root"
dest="${SHELLS_BACKUP_ROOT:-/srv/shells/backups}/$aid"
mkdir -p "$dest"; chmod 0700 "$dest"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="$dest/$stamp.tar.gz"
tar -C "$root" --exclude='services/*/run' --exclude='services/*/logs' -czf "$archive" config data services
sha256sum "$archive" >"$archive.sha256"
chmod 0600 "$archive" "$archive.sha256"
echo "$archive"
